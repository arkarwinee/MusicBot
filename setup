#!/bin/bash

set -uo pipefail
umask 077

[ -n "$BASH_VERSION" ] || { echo "Run with bash"; exit 1; }
command -v sudo &>/dev/null || { echo "sudo is required"; exit 1; }
command -v apt-get &>/dev/null || { echo "This installer requires apt (Debian/Ubuntu)"; exit 1; }

pprint() {
    local msg="$1" c="$2" r="\033[0m"
    case "$c" in
        cred) c="\033[0;31m";; cgreen) c="\033[0;32m";;
        cyellow) c="\033[0;33m";; cblue) c="\033[0;34m";;
        cmagenta) c="\033[0;35m";; *) c="\033[0;35m";;
    esac
    printf "%b%b%b" "$c" "$msg" "$r"
}

update() {
    pprint "\n\nUpdating system...\n" "cblue"
    if sudo apt-get update -y &>/dev/null && sudo apt-get upgrade -y &>/dev/null; then
        pprint "Done.\n\n" "cgreen"
    else
        pprint "Failed.\n\n" "cred"
        return 1
    fi
}

install_pkgs() {
    local pkg missing=()
    for pkg in "$@"; do
        dpkg -s "$pkg" &>/dev/null || missing+=("$pkg")
    done

    if [ ${#missing[@]} -gt 0 ]; then
        pprint "Installing: ${missing[*]}... " "cyellow"
        if sudo apt-get install -y "${missing[@]}" &>/dev/null; then
            pprint "Done.\n\n" "cgreen"
        else
            pprint "Failed.\n\n" "cred"
            return 1
        fi
    else
        pprint "All packages already installed.\n\n" "cgreen"
    fi
}

install_deno() {
    pprint "\n\nInstalling Deno...\n" "cblue"

    if command -v deno &>/dev/null; then
        pprint "Deno already installed.\n" "cgreen"
        return 0
    fi

    if curl -fsSL https://deno.land/install.sh | sh; then
        if ! grep -q 'DENO_INSTALL' "$HOME/.bashrc"; then
            {
                echo 'export DENO_INSTALL="$HOME/.deno"'
                echo 'export PATH="$DENO_INSTALL/bin:$PATH"'
            } >> "$HOME/.bashrc"
            pprint "Deno path added to ~/.bashrc\n" "cyellow"
        fi
        export DENO_INSTALL="$HOME/.deno"
        export PATH="$DENO_INSTALL/bin:$PATH"
        pprint "Deno installation complete.\n" "cgreen"
    else
        pprint "Deno installation failed.\n" "cred"
        return 1
    fi
}

install_uv() {
    if command -v uv &>/dev/null; then
        return 0
    fi

    pprint "\nInstalling uv...\n" "cblue"
    if curl -Ls https://astral.sh/uv/install.sh | sh; then
        if ! grep -q '.local/bin' "$HOME/.bashrc"; then
            echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
        fi
        export PATH="$HOME/.local/bin:$PATH"
        pprint "uv installed.\n" "cgreen"
    else
        pprint "uv installation failed.\n" "cred"
        return 1
    fi
}

install_py() {
    pprint "\n\nInstalling Python dependencies...\n" "cblue"
    if uv sync --frozen -q; then
        pprint "Done.\n" "cgreen"
    else
        pprint "Failed.\n" "cred"
        return 1
    fi
}

prompt_required() {
    # prompt_required VAR_NAME "Prompt text" [secret]
    local __var="$1" __prompt="$2" __secret="${3:-}" __val=""
    while [ -z "$__val" ]; do
        if [ "$__secret" = "secret" ]; then
            read -rsp "$__prompt: " __val; echo
        else
            read -rp "$__prompt: " __val
        fi
        [ -z "$__val" ] && pprint "This field can't be empty.\n" "cred"
    done
    printf -v "$__var" '%s' "$__val"
}

save_env_vars() {
    pprint "\n\nWriting .env..." "cgreen"
    umask 177
    cat >.env <<EOF
API_ID=${api_id}
API_HASH=${api_hash}
BOT_TOKEN=${bot_token}
MONGO_URL=${mongo_db}
LOGGER_ID=${logger}
SESSION=${string_session}
OWNER_ID=${ownid}
EOF
    chmod 600 .env
    pprint " done.\n" "cgreen"
}

main() {
    pprint "Welcome to the AnonXMusic Installation Setup\n\n" "cmagenta"

    update || pprint "Continuing despite update failure...\n" "cyellow"
    install_pkgs python3 python3-venv ffmpeg curl unzip || { pprint "Required packages missing, aborting.\n" "cred"; exit 1; }
    install_uv || { pprint "uv is required, aborting.\n" "cred"; exit 1; }
    install_deno || { pprint "Deno is required, aborting.\n" "cred"; exit 1; }
    install_py || { pprint "Python dependency install failed, aborting.\n" "cred"; exit 1; }

    pprint "\nAnonXMusic Installation Completed.\n" "cgreen"
    pprint "\nEnter Your Values Below\n\n\n" "cmagenta"

    prompt_required api_id "API ID"
    [[ "$api_id" =~ ^[0-9]+$ ]] || { pprint "API ID must be numeric.\n" "cred"; exit 1; }
    prompt_required api_hash "API HASH" secret
    prompt_required bot_token "BOT TOKEN" secret
    prompt_required ownid "OWNER ID"
    [[ "$ownid" =~ ^-?[0-9]+$ ]] || { pprint "OWNER ID must be numeric.\n" "cred"; exit 1; }
    prompt_required mongo_db "MONGO URL" secret
    prompt_required logger "LOG GROUP ID"
    prompt_required string_session "STRING SESSION" secret

    save_env_vars
    pprint "\nSetup complete! Start the bot using:\n\n  bash start\n\n" "cgreen"
}

main "$@"